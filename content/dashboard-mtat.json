     "type": "TextDisplay",
     "title": "How to export to MTAT",
     "config": {
      "refreshInterval": 300,
      "widgetId": "d048b55b-d723-51c4-9fcb-eaadc380ae57",
      "description": "",
      "title": "How to export to MTAT",
      "refreshContent": {
