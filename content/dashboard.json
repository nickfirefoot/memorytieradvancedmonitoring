   "id": "089a4b09-27fb-5213-9836-e9dd8f0e2639",
   "name": "Memory Tiering Sizing - Clusters",
   "description": "Sizing a vSphere estate for NVMe memory tiering, from metrics the vCenter adapter already collects.",
   "userId": "00000000-0000-0000-0000-000000000000",
   "lastUpdateUserId": "00000000-0000-0000-0000-000000000000",
   "shared": true,
